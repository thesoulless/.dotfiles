alias vim="nvim"
alias vi="nvim"
alias g="git"
alias gw="g worktree"
alias gwa="gw add"
alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
alias tf="terraform"

VIM="nvim"

export GIT_EDITOR=$VIM

bindkey -s '^f' 'tmux-sessionizer\n'
bindkey -s '^s' 'so\n'

addToPath() {
    path+=($1)
    export PATH
}

addToPath $HOME/.local/scripts
# Homebrew (only nushell/antidote/fzf until migration step 2). Appended, so the
# Nix paths that nix-darwin's /etc/zshenv puts first keep winning.
addToPath /opt/homebrew/bin
addToPath /opt/homebrew/sbin
